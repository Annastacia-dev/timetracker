{
  "name": "timetracker",
  "productName": "TimeTracker",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop time tracker for client projects: timer, idle detection, screenshots, activity, reports and invoices.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && node scripts/start.mjs",
    "dist": "vite build && electron-builder --win --publish never",
    "smoke": "vite build && node scripts/smoke-run.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "icons": "node scripts/icons.mjs",
    "test:schema": "node supabase/test-schema.mjs",
    "ui:cloud": "vite build && node -e \"const {spawn}=require('child_process');const e=require('electron');const env={...process.env};delete env.ELECTRON_RUN_AS_NODE;spawn(e,['scripts/cloud-ui-shot.cjs'],{stdio:'inherit',env}).on('exit',c=>process.exit(c))\""
  },
  "build": {
    "appId": "com.local.timetracker",
    "productName": "TimeTracker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "app-config.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "shortcutName": "TimeTracker",
      "artifactName": "TimeTracker-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "TimeTracker",
        "schemes": [
          "timetracker"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Annastacia-dev",
        "repo": "timetracker",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Annastacia-dev/timetracker.git"
  }
}
